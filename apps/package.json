    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^3.1.1",
    "yarn": "^1.22.22"
  },
  "scarfSettings": {
    "enabled": false
  },
  "resolutions": {
    "@radix-ui/react-focus-scope": "^1.0.4",
    "@radix-ui/react-dismissable-layer": "^1.0.5"
  }
