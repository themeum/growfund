{
  "name": "growfund",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "tsx growfund/src/scripts/build-env.ts development && vite",
    "build": "tsx growfund/src/scripts/build-env.ts production && VITE_APP_TYPE=main vite build",
    "lint": "eslint .",
    "lint:debug": "eslint . --debug",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run --reporter=verbose",
    "extract:option-defaults": "tsx growfund/src/scripts/defaults.ts optionDefaults",
    "wp": "docker compose run --rm wpcli",
    "make:pot": "yarn wp i18n make-pot wp-content/plugins/growfund wp-content/plugins/growfund/languages/growfund.pot --slug=growfund --domain=growfund --include='growfund.php,**/*.php,resources/dist/*.js' --exclude='vendor'"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
